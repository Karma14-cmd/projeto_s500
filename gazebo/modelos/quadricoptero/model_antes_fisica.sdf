<?xml version="1.0" ?>
<sdf version="1.10">

  <model name="quadricoptero">

    <!-- Corpo físico principal -->
    <link name="base_link">

      <pose>0 0 0.5 0 0 0</pose>

      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.02</iyy>
          <izz>0.03</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- Colisão simplificada -->
      <collision name="collision">
        <geometry>
          <box>
            <size>0.40 0.40 0.15</size>
          </box>
        </geometry>
      </collision>

      <!-- Modelo 3D do S500 vindo do Ansys -->
      <visual name="s500_visual">

        <geometry>
          <mesh>
            <uri>model://quadricoptero/meshes/S500_Frame.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>

      </visual>
      <!-- ========================= -->
      <!-- MOTORES DO S500 - VISUAL -->
      <!-- ========================= -->

      <!-- Motor 1 -->
      <visual name="motor_1_visual">
        <pose>0.15 0.15 0.05 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
      </visual>

      <!-- Motor 2 -->
      <visual name="motor_2_visual">
        <pose>-0.15 0.15 0.05 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
      </visual>

      <!-- Motor 3 -->
      <visual name="motor_3_visual">
        <pose>-0.15 -0.15 0.05 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
      </visual>

      <!-- Motor 4 -->
      <visual name="motor_4_visual">
        <pose>0.15 -0.15 0.05 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
      </visual>
<!-- ==================== HÉLICES ==================== -->

<!-- Hélice do Motor 1 -->
<visual name="helice_1_a">
  <pose>0.15 0.15 0.09 0 0 0.25</pose>
  <geometry>
    <box>
      <size>0.18 0.015 0.005</size>
    </box>
  </geometry>
</visual>

<visual name="helice_1_b">
  <pose>0.15 0.15 0.09 0 0 -0.25</pose>
  <geometry>
    <box>
      <size>0.18 0.015 0.005</size>
    </box>
  </geometry>
</visual>


<!-- Hélice do Motor 2 -->
<visual name="helice_2_a">
  <pose>-0.15 0.15 0.09 0 0 -0.25</pose>
  <geometry>
    <box>
      <size>0.18 0.015 0.005</size>
    </box>
  </geometry>
</visual>

<visual name="helice_2_b">
  <pose>-0.15 0.15 0.09 0 0 0.25</pose>
  <geometry>
    <box>
      <size>0.18 0.015 0.005</size>
    </box>
  </geometry>
</visual>


<!-- Hélice do Motor 3 -->
<visual name="helice_3_a">
  <pose>-0.15 -0.15 0.09 0 0 0.25</pose>
  <geometry>
    <box>
      <size>0.18 0.015 0.005</size>
    </box>
  </geometry>
</visual>

<visual name="helice_3_b">
  <pose>-0.15 -0.15 0.09 0 0 -0.25</pose>
  <geometry>
    <box>
      <size>0.18 0.015 0.005</size>
    </box>
  </geometry>
</visual>


<!-- Hélice do Motor 4 -->
<visual name="helice_4_a">
  <pose>0.15 -0.15 0.09 0 0 -0.25</pose>
  <geometry>
    <box>
      <size>0.18 0.015 0.005</size>
    </box>
  </geometry>
</visual>

<visual name="helice_4_b">
  <pose>0.15 -0.15 0.09 0 0 0.25</pose>
  <geometry>
    <box>
      <size>0.18 0.015 0.005</size>
    </box>
  </geometry>
</visual>
    </link>

  </model>

</sdf>
