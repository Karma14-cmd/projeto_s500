<?xml version="1.0" ?>
<sdf version="1.10">

  <model name="quadricoptero">

    <!-- Corpo físico principal -->
    <link name="base_link">

      <pose>0 0 0.5 0 0 0</pose>

      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.02</iyy>
          <izz>0.03</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- Colisão simplificada -->
      <collision name="collision">
        <geometry>
          <box>
            <size>0.40 0.40 0.15</size>
          </box>
        </geometry>
      </collision>

      <!-- Modelo 3D do S500 vindo do Ansys -->
      <visual name="s500_visual">

        <geometry>
          <mesh>
            <uri>model://quadricoptero/meshes/S500_Frame.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>

      </visual>

    </link>

  </model>

</sdf>
