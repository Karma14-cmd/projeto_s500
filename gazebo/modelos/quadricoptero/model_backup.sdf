<?xml version="1.0" ?>
<sdf version="1.10">

  <model name="quadricoptero">

    <!-- Corpo central -->
    <link name="corpo">

      <pose>0 0 0.5 0 0 0</pose>

      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.02</iyy>
          <izz>0.03</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- Corpo físico -->
      <collision name="collision">
        <geometry>
          <box>
            <size>0.30 0.30 0.12</size>
          </box>
        </geometry>
      </collision>

      <!-- Corpo visual -->
      <visual name="visual">
        <geometry>
          <box>
            <size>0.30 0.30 0.12</size>
          </box>
        </geometry>
      </visual>

    </link>

    <!-- Braço 1 -->
    <link name="braco1">
      <pose>0.35 0 0.5 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.55 0.06 0.06</size>
          </box>
        </geometry>
      </visual>
    </link>

    <!-- Braço 2 -->
    <link name="braco2">
      <pose>-0.35 0 0.5 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.55 0.06 0.06</size>
          </box>
        </geometry>
      </visual>
    </link>

    <!-- Braço 3 -->
    <link name="braco3">
      <pose>0 0.35 0.5 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.06 0.55 0.06</size>
          </box>
        </geometry>
      </visual>
    </link>

    <!-- Braço 4 -->
    <link name="braco4">
      <pose>0 -0.35 0.5 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.06 0.55 0.06</size>
          </box>
        </geometry>
      </visual>
    </link>

  </model>

</sdf>
